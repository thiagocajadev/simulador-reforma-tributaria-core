{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types"]
  },
  "include": [
    "src/worker",
    "src/features/*/*.route.ts",
    "src/features/*/*.route.test.ts",
    "src/features/*/*.d1.test.ts",
    "src/features/calculations/operation.calculate.ts",
    "src/features/simples-nacional/operation.simples.ts",
    "src/features/*/*.dto.ts",
    "src/features/*/*.repository.ts",
    "src/features/*/*.compose.ts",
    "src/features/*/*.compose.test.ts",
    "src/shared/http/envelope.ts",
    "src/shared/http/query.params.ts",
    "src/shared/http/problem.respond.ts",
    "src/shared/http/rate.limit.ts",
    "src/shared/data",
    "src/shared/testing",
    "worker-configuration.d.ts"
