{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simulador-reforma-tributaria-core",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-20",
  "d1_databases": [
    {
      "binding": "OPEN_DATA",
      "database_name": "simulador-open-data",
      // why: local development and the tests need no real id; a deploy takes the one
      // `wrangler d1 create simulador-open-data` prints (docs/deploy.md).
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  // why: one namespace per binding, unique in the account; both count per client address, per minute.
  "ratelimits": [
    {
      "name": "SEARCH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "CALCULATION_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  // why: the Free plan writes 200,000 events a day; every request logs one invocation event (docs/observability.md).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": true }
  }
}
